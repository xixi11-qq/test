{
  "expo": {
    "name": "Gojo Simple",
    "slug": "gojo-simple",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#070d1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gojo.simple"
    },
    "android": {
      "package": "com.gojo.simple",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#070d1a"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "androidMode": "default",
          "androidCollapsedTitle": "Gojo"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 App 访问相册以选择要发送给 AI 的图片",
          "cameraPermission": "允许 App 使用相机以拍照发送给 AI"
        }
      ]
    ],
    "scheme": "gojosimple",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5df9225c-8bd9-4e0a-8047-95df8fca8baf"
      }
    },
    "owner": "egjbs"
  }
}
